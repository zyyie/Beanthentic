# --- Supabase (Admin + App + Client — anon / publishable key) ---
BEANTHENTIC_SUPABASE_URL=https://YOUR_REF.supabase.co
BEANTHENTIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
BEANTHENTIC_SUPABASE_PROJECT_REF=YOUR_REF

# --- Optional: LAN app server for legacy profile photo files (/uploads/farmers/…) ---
# BEANTHENTIC_APP_SERVER_BASE=http://192.168.x.x:8080

# --- Optional: Supabase Storage for profile photos (Admin + App only, not Client) ---
# BEANTHENTIC_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# BEANTHENTIC_SUPABASE_STORAGE_BUCKET=profile-photos

# --- Admin LAN URL (port 5000) — required for GI/IPOPHL files on mobile app ---
# BEANTHENTIC_ADMIN_PUBLIC_BASE=http://192.168.x.x:5000
# Client Web + mobile app use GET {admin}/api/supabase-config for Supabase URL + anon key.
# Optional app server (port 8080) — only needed for legacy LAN bridges:
# BEANTHENTIC_APP_SERVER_BASE=http://192.168.x.x:8080

# --- Optional: Stadia Maps (dashboard Maps module — free tier / developer-friendly) ---
# Localhost works without a key. For production, add domain auth in Stadia dashboard or:
# STADIA_MAPS_API_KEY=your-stadia-api-key
# Or settings.json: "maps": { "stadia_api_key": "your-key" }

# --- Optional: server-side SQL for admin SQLAlchemy (same Supabase project) ---
# Without this, admin SQLAlchemy uses local SQLite at data/admin_sqlalchemy.db while
# farmers/pricing continue via Supabase anon REST.
# After unpausing a Supabase project, reset the database password in Dashboard → Database
# and update BEANTHENTIC_DB_PASS below (or set a full BEANTHENTIC_DB_URL).
# BEANTHENTIC_DB_URL=postgresql://postgres.YOUR_REF:YOUR_DB_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
# BEANTHENTIC_DB_TYPE=postgresql
# BEANTHENTIC_DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
# BEANTHENTIC_DB_PORT=5432
# BEANTHENTIC_DB_USER=postgres
# BEANTHENTIC_DB_PASS=your-db-password
# BEANTHENTIC_DB_NAME=postgres

# Post-deploy module smoke (requires admin login cookie):
#   GET http://127.0.0.1:5000/api/admin/system-check
